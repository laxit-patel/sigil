{
  "version": "1.1",
  "range": { "min": 0, "max": 9999 },
  "places": ["ones", "tens", "hundreds", "thousands"],
  "geometryDefaults": {
    "stemHeight": 200,
    "quadrantWidth": 70,
    "stemX": 100,
    "stemTopY": 20
  },
  "segments": [
    { "key": "top",      "coords": [0, 0, 1, 0] },
    { "key": "bottom",   "coords": [0, 1, 1, 1] },
    { "key": "outer",    "coords": [1, 0, 1, 1] },
    { "key": "diagDown", "coords": [0, 0, 1, 1] },
    { "key": "diagUp",   "coords": [0, 1, 1, 0] }
  ],
  "digitMap": [0, 1, 2, 8, 16, 3, 4, 5, 6, 7],
  "quadrants": {
    "ones":      { "placeValue": 1,    "flipX": false, "flipY": false },
    "tens":      { "placeValue": 10,   "flipX": true,  "flipY": false },
    "hundreds":  { "placeValue": 100,  "flipX": false, "flipY": true },
    "thousands": { "placeValue": 1000, "flipX": true,  "flipY": true }
  }
}
