{
    "name": "laxit/sigil",
    "description": "Turn an integer 0-9999 into one recognizable Cistercian-style glyph: SVG, ASCII or DXF.",
    "keywords": [
        "cistercian",
        "glyph",
        "sigil",
        "svg",
        "dxf",
        "ascii",
        "identicon"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/laxit-patel/php-sigil",
    "support": {
        "issues": "https://github.com/laxit-patel/php-sigil/issues",
        "source": "https://github.com/laxit-patel/php-sigil"
    },
    "authors": [
        {
            "name": "laxit-patel",
            "email": "laxxitpatel@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Laxit\\Sigil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laxit\\Sigil\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "vectors": "php bin/vectors.php",
        "vectors:check": "php bin/vectors.php --check"
    },
    "config": {
        "sort-packages": true
    }
}
